{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoDo",
  "version": "0.1.0",
  "identifier": "dev.piwork.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:document-runtime:debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:document-runtime:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoDo",
        "width": 1232,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "binaries/pi-sidecar": "pi-sidecar",
      "binaries/document-runtime": "document-runtime",
      "assets/piwork-host-tools.ts": "piwork-host-tools.ts"
    },
    "icon": [
      "codo-icons/32x32.png",
      "codo-icons/128x128.png",
      "codo-icons/128x128@2x.png",
      "codo-icons/icon.png",
      "codo-icons/icon.icns",
      "codo-icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A dependable AI partner for getting work done",
    "windows": {
      "nsis": {
        "installerIcon": "codo-icons/icon.ico",
        "uninstallerIcon": "codo-icons/icon.ico"
      }
    }
  }
}
